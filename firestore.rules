rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Sustituye este valor con el UID de la cuenta administrativa creada
    // en Firebase Authentication antes de publicar estas reglas.
    function isPrayerAdmin() {
      return request.auth != null
        && request.auth.uid == "wGpQj6f5jUV9X0xRfz8D7mEYSbO2";
    }

    function hasValidPrayerFields() {
      return request.resource.data.keys().hasOnly([
          "contactId",
          "text",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.contactId is string
        && request.resource.data.contactId.size() > 0
        && request.resource.data.contactId.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /prayers/{prayerId} {
      allow read: if isPrayerAdmin();
      allow create: if isPrayerAdmin() && hasValidPrayerFields();
      allow update: if isPrayerAdmin()
        && hasValidPrayerFields()
        && request.resource.data.contactId == resource.data.contactId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isPrayerAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
