# Configuración pública de la aplicación web de Firebase.
# Estos valores se obtienen en Firebase Console → Configuración del proyecto.
VITE_FIREBASE_API_KEY=REEMPLAZA_CON_API_KEY
VITE_FIREBASE_PROJECT_ID=REEMPLAZA_CON_PROJECT_ID

# Correo de la única cuenta creada en Firebase Authentication.
# La aplicación solo muestra el campo de contraseña al administrador.
VITE_FIREBASE_ADMIN_EMAIL=administrador@ejemplo.com
